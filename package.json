{
    "name": "@niaga/lib-ui",
    "version": "0.0.0",
    "private": true,
    "description": "Shared UI library for Niaga frontends — primitives + per-frontend domain components",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./brand": "./src/brand.ts",
        "./lib/utils": "./src/lib/utils.ts",
        "./tailwind.preset": "./tailwind.preset.ts",
        "./primitives": "./src/primitives/index.ts",
        "./primitives/*": "./src/primitives/*.tsx",
        "./styles/globals.css": "./src/styles/globals.css",
        "./styles/themes/admin.css": "./src/styles/themes/admin.css",
        "./styles/themes/storefront.css": "./src/styles/themes/storefront.css",
        "./styles/themes/warehouse.css": "./src/styles/themes/warehouse.css",
        "./storefront/checkout/*": "./src/storefront/checkout/*.tsx",
        "./admin/analytics/*": "./src/admin/analytics/*.tsx",
        "./admin/auth/*": "./src/admin/auth/*.tsx",
        "./admin/categories/categories": "./src/admin/categories/categories.ts",
        "./admin/categories/*": "./src/admin/categories/*.tsx",
        "./admin/collections/collections": "./src/admin/collections/collections.ts",
        "./admin/collections/*": "./src/admin/collections/*.tsx",
        "./admin/common/*": "./src/admin/common/*.tsx",
        "./admin/content/banners": "./src/admin/content/banners.ts",
        "./admin/content/*": "./src/admin/content/*.tsx",
        "./admin/marketplace/marketplace": "./src/admin/marketplace/marketplace.ts",
        "./admin/marketplace/*": "./src/admin/marketplace/*.tsx",
        "./admin/payments/*": "./src/admin/payments/*.tsx",
        "./admin/polaris": "./src/admin/polaris/index.ts",
        "./admin/products/products": "./src/admin/products/products.ts",
        "./admin/products/*": "./src/admin/products/*.tsx",
        "./admin/settings/*": "./src/admin/settings/*.tsx",
        "./admin/size-charts/*": "./src/admin/size-charts/*.tsx",
        "./admin/users/users": "./src/admin/users/users.ts",
        "./admin/users/*": "./src/admin/users/*.tsx",
        "./warehouse": "./src/warehouse/index.ts",
        "./warehouse/*": "./src/warehouse/*.tsx"
    },
    "scripts": {
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.4.0"
    },
    "peerDependencies": {
        "@hookform/resolvers": "^3.3.4",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-radio-group": "^1.2.0",
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "class-variance-authority": "^0.7.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.555.0",
        "next": "^14.2.33",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.49.3",
        "recharts": "^3.5.1",
        "sonner": "^2.0.7",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.19.25",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5"
    }
}
